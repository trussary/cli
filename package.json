{
  "name": "trussary",
  "version": "0.1.0",
  "description": "Security check for apps built with AI — finds exposed keys, missing Supabase RLS, unauthenticated endpoints and more, explained in plain language.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "trussary": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trussary/cli.git"
  },
  "homepage": "https://trussary.com",
  "bugs": {
    "url": "https://github.com/trussary/cli/issues"
  },
  "keywords": [
    "security",
    "scanner",
    "vibe-coding",
    "ai-generated",
    "supabase",
    "rls",
    "nextjs",
    "vite",
    "vercel",
    "express",
    "lovable",
    "bolt",
    "replit",
    "v0",
    "claude-code",
    "secrets",
    "api-keys",
    "cli"
  ],
  "dependencies": {
    "fdir": "^6.4.0",
    "picocolors": "^1.1.0",
    "picomatch": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/picomatch": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
